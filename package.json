{
  "name": "marketing-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "行銷影片工作台：網頁、OCR／字幕產線與 Remotion 模板",
  "scripts": {
    "setup": "npm ci",
    "init": "node tools/init.js",
    "doctor": "node tools/doctor.js",
    "verify": "node tools/verify.js",
    "check:release": "node tools/release-check.js",
    "setup:whisper": "python3 tools/whisper/setup-whisper.py",
    "test": "node --test \"server/tests/*.test.js\" \"video/tests/*.test.js\" \"shared/tests/*.test.js\" \"tools/tests/*.test.js\"",
    "studio": "node --watch server/start.js",
    "transcribe": "bash video/pipeline/transcribe.sh",
    "correct-subtitles": "node video/pipeline/correct-subtitles.js",
    "check-voices": "node video/pipeline/check-voices.js",
    "check:pronounce": "node video/pipeline/check-pronunciation.js",
    "stocks": "node video/pipeline/update-stock-names.js",
    "analyze:app-images": "node video/pipeline/analyze-app-images.js",
    "render-motion": "node video/pipeline/render-motion.js",
    "use-dapan-assets": "node video/pipeline/use-dapan-assets.js",
    "parse-script:dapan": "node video/pipeline/parse-dapan-script.js",
    "auto-shot:dapan": "node video/pipeline/auto-shot.js --write --out src/DapanXiaobao/dapan-shots.generated.json",
    "render:dapan": "remotion render DapanXiaobao storage/tmp/pipeline-output/output-dapan.mp4 --config=video/remotion/remotion.config.ts",
    "render:dapan-landscape": "remotion render DapanXiaobaoLandscape storage/tmp/pipeline-output/output-dapan-landscape.mp4 --config=video/remotion/remotion.config.ts",
    "use-midday-assets": "node video/pipeline/use-midday-assets.js",
    "parse-script:midday": "node video/pipeline/parse-midday-script.js",
    "auto-shot:midday": "node video/pipeline/auto-shot.js --write --out src/MiddayFocus/midday-shots.generated.json",
    "render:midday": "remotion render MiddayFocus storage/tmp/pipeline-output/output-midday.mp4 --config=video/remotion/remotion.config.ts",
    "use-usstock-assets": "node video/pipeline/use-usstock-assets.js",
    "parse-script:usstock": "node video/pipeline/parse-usstock-script.js",
    "auto-shot:usstock": "node video/pipeline/auto-shot.js --write --out src/UsStock/usstock-shots.generated.json",
    "render:usstock": "remotion render UsStock storage/tmp/pipeline-output/output-usstock.mp4 --config=video/remotion/remotion.config.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@remotion/cli": "^4.0.0",
    "dotenv": "^17.4.2",
    "opencc-js": "^1.3.1",
    "pinyin-pro": "^3.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/web": "^0.0.150",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
