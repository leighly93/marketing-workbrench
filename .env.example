# 複製或由 npm run init 建立 .env；不要提交真實憑證。
HOST=127.0.0.1
PORT=4000
# init 建立新 .env 時會產生隨機管理金鑰；空值只開放本機管理。
ADMIN_KEY=

# 新生成講者影片需要；沿用現成影片可略過。
HEYGEN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 截圖辨識：tesseract 或 vision（後者限 macOS）
OCR_ENGINE=tesseract
PAGE_RULES=v1
SHOT_MEMORY=single

# 選用實驗／整合，核心本機驗證不需要。
OPENAI_API_KEY=
FAL_KEY=
