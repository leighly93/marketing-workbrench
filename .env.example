# 複製或由 npm run init 建立 .env；不要提交真實憑證。
HOST=127.0.0.1
PORT=4000
# init 建立新 .env 時會產生隨機管理金鑰；空值只開放本機管理。
ADMIN_KEY=

# 新生成講者影片需要；沿用現成影片可略過。
HEYGEN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# 截圖辨識：tesseract 或 vision（後者限 macOS）
OCR_ENGINE=tesseract
# 字幕：whisper.cpp Base Q5_1，CPU／4 執行緒／中文
TRANSCRIPTION_ENGINE=whisper-cpp
# 留空使用 npm run setup:whisper 安裝的專案內工具與模型
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
PAGE_RULES=v1
SHOT_MEMORY=single

# 動態小影片的參數由誰產生：claude-cli（預設，用 claude -p）或 manual（只吃前台貼的參數）
MOTION_ENGINE=claude-cli
# 背景服務跑 claude -p 用的長期 token（claude setup-token 產生，吃訂閱不是 API key，效期一年）。
# 服務讀不到 login keychain，沒有這個就會是「Not logged in」、整支影片沒有動態。
# 在終端互動使用時不需要它。
CLAUDE_CODE_OAUTH_TOKEN=

# 選用實驗／整合，核心本機驗證不需要。
OPENAI_API_KEY=
FAL_KEY=
